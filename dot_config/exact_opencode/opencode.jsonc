  "mcp": {
      "context7": {
        "enabled": true,
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "engram": {
        "command": [
          "engram",
          "mcp",
          "--tools=agent"
        ],
        "type": "local"
      }
    },
  "permission": {
      "bash": {
        "*": "allow",
        "git commit *": "ask",
        "git push": "ask",
        "git push *": "ask",
        "git push --force *": "ask",
        "git rebase *": "ask",
        "git reset --hard *": "ask",
        "rsync": "ask",
        "rsync *": "ask",
        "scp": "ask",
        "scp *": "ask",
        "sftp": "ask",
        "sftp *": "ask",
        "ssh": "ask",
        "ssh *": "ask"
      },
      "read": {
        "*": "allow",
        "**/*.key": "deny",
        "**/*.pem": "deny",
        "**/.aws/credentials": "deny",
        "**/.config/gh/hosts.yml": "deny",
        "**/.credentials/**": "deny",
        "**/.env": "deny",
        "**/.env.*": "deny",
        "**/.ssh/**": "deny",
        "**/Library/Keychains/**": "deny",
        "**/credentials.json": "deny",
        "**/secrets/**": "deny",
        "*.env": "deny",
        "*.env.*": "deny"
      },
      "mcp_*": "ask"
    },
  "plugin": [
    "/home/django/.ecc/.opencode/plugins"
  ],
  "skills": {
    "paths": [
      "/home/django/.ecc/skills"
    ]
  }
}
