# vim: filetype=neomuttrc
# muttrc file for account edpu0033@gmail.com
set realname = "edpu0033"
set from = "edpu0033@gmail.com"
set sendmail = "msmtp -a edpu0033@gmail.com"
alias me edpu0033 <edpu0033@gmail.com>
set folder = "/home/django/.local/share/mail/edpu0033@gmail.com"
set header_cache = /home/django/.cache/mutt-wizard/edpu0033@gmail.com/headers
set message_cachedir = /home/django/.cache/mutt-wizard/edpu0033@gmail.com/bodies
set mbox_type = Maildir
set hostname = "gmail.com"
source /usr/share/mutt-wizard/switch.muttrc
set spoolfile = +INBOX
set postponed = +Drafts
set trash = +Trash
set record = +Sent

macro index o "<shell-escape>mw -y edpu0033@gmail.com<enter>" "run mbsync to sync edpu0033@gmail.com"
macro index \eg "<enter-command>unset wait_key<enter><shell-escape>gpg --list-secret-keys; printf 'Enter email ID of user to publish: '; read eID; printf 'Enter fingerprint of GPG key to publish: '; read eFGPT; /usr/libexec/gpg-wks-client --create \$eFGPT \$eID | msmtp --read-envelope-from --read-recipients -a edpu0033@gmail.com<enter>"  "publish GPG key to WKS provider"
macro index \eh "<pipe-message>/usr/libexec/gpg-wks-client --receive | msmtp --read-envelope-from --read-recipients -a edpu0033@gmail.com<enter>" "confirm GPG publication"

mailboxes "=Destacados" "=INBOX" "=[Gmail]/All Mail" "=[Gmail]/Drafts" "=[Gmail]/Important" "=[Gmail]/Papelera/Nintendo" "=[Gmail]/Papelera/Warda" "=[Gmail]/Sent Mail" "=[Gmail]/Spam" "=[Gmail]/Starred" "=[Gmail]/Trash"
