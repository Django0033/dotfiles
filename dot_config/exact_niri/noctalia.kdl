layout {

    focus-ring {
        active-color   "#7c67e4"
        inactive-color "#18142a"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#7c67e4"
        inactive-color "#18142a"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#7c67e4"
        inactive-color "#271485"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#7c67e480"
    }
}

recent-windows {
    highlight {
        active-color "#7c67e4"
        urgent-color "#fd4663"
    }
}
